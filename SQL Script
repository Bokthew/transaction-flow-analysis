   Source  : whmart_union_compre_lite_sep_fix, whmart_list_oilgas_lite
   Result  : edl_sandbox.whmart_union_compre_lite_sep_oilgas_only
   --------------------------------------------------------------------- */

-- DROP TABLE edl_sandbox.whmart_union_compre_lite_sep_oilgas_only PURGE;

-- 19a. Table for Oil & Gas customers
CREATE TABLE edl_sandbox.whmart_union_compre_lite_sep_oilgas_only 
STORED AS PARQUET AS
WITH oilgas_only AS (
    SELECT u.*
    FROM edl_sandbox.whmart_union_compre_lite_sep_fix u
    JOIN edl_sandbox.whmart_list_oilgas_lite og
        ON u.nocif_principal = og.nocif
)
SELECT * FROM oilgas_only
;

-- 19b. Oil & Gas summary
SELECT
    source, flag_own, flag_bank_trx_bsi, flag_outflow_nbsi_final,
    SUM(debit_vol)      AS debit_vol,
    SUM(debit_vol_mly)  AS debit_vol_mly,
    SUM(credit_vol)     AS credit_vol,
    SUM(credit_vol_mly) AS credit_vol_mly
FROM edl_sandbox.whmart_union_compre_lite_sep_oilgas_only
WHERE batch_date = '2026-09-30'
GROUP BY source, flag_own, flag_bank_trx_bsi, flag_outflow_nbsi_final
;

-- 19c. Largest counterparties (Oil & Gas)
WITH base AS (
    SELECT *, ROW_NUMBER() OVER (ORDER BY debit_vol DESC) AS rn
    -- SELECT *, ROW_NUMBER() OVER (ORDER BY debit_vol_mly DESC) AS rn
    FROM (
        SELECT
            nama_rekanan, nama_principal,
            nocif_rekanan, nocif_principal,
            SUM(NVL(debit_vol, 0)) AS debit_vol
            -- SUM(NVL(debit_vol_mly, 0)) AS debit_vol_mly
        FROM edl_sandbox.whmart_union_compre_lite_sep_oilgas_only
        WHERE flag_bank_trx_bsi = 0
          AND flag_own = 0
          AND flag_outflow_nbsi_final = 1
          AND NVL(CAST(nocif_rekanan AS BIGINT), 0) <> NVL(CAST(nocif_principal AS BIGINT), 0)
          AND nama_rekanan <> nama_principal
          AND batch_date = '2026-09-30'
        GROUP BY 1, 2, 3, 4
    ) x
),
final AS (
    SELECT *, debit_vol / 1e9 AS debit_vol_miliar
    -- SELECT *, debit_vol_mly / 1e9 AS debit_vol_mly_miliar
    FROM base
)
SELECT * FROM final
;

-- 19d. Top 20 destination banks (Oil & Gas)
WITH base AS (
    SELECT *, ROW_NUMBER() OVER (ORDER BY debit_vol DESC) AS rn
    -- SELECT *, ROW_NUMBER() OVER (ORDER BY debit_vol_mly DESC) AS rn
    FROM (
        SELECT bank_rekanan, SUM(NVL(debit_vol, 0)) AS debit_vol
        -- SELECT bank_rekanan, SUM(NVL(debit_vol_mly, 0)) AS debit_vol_mly
        FROM edl_sandbox.whmart_union_compre_lite_sep_oilgas_only
        WHERE flag_bank_trx_bsi = 0
          AND flag_own = 0
          AND flag_outflow_nbsi_final = 1
          AND batch_date = '2026-09-30'
        GROUP BY 1
    ) x
)
SELECT *, debit_vol / 1e9 AS debit_vol_miliar
-- SELECT *, debit_vol_mly / 1e9 AS debit_vol_mly_miliar
FROM base
WHERE rn BETWEEN 1 AND 20
;
