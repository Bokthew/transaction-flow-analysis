------------------------------------------------------------------------- */


/* ---------------------------------------------------------------------
   STEP 10 : PROFILE OF OTHER-SEGMENT CUSTOMERS
   Purpose : Build a monthly profile of business-entity customers outside Corporate
             & Commercial that are not yet in the main TFD: deposit balance per
             product type, financing, collectibility, and economic sector.
   Source  : master_dpk_bsi, master_pembiayaan, customer_latest,
            ref_sektor_ekonomi
   Result  : edl_sandbox.da_ad_tfdlite_corp_kutu_augsep_only
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.da_ad_tfdlite_corp_kutu_augsep_only;
-- Check result: SELECT * FROM edl_sandbox.da_ad_tfdlite_corp_kutu_augsep_only LIMIT 100;

CREATE TABLE edl_sandbox.da_ad_tfdlite_corp_kutu_augsep_only
STORED AS PARQUET AS

WITH
-- 10.1 Customers already in the main TFD (at the latest date) - to be excluded
tmp_tfd_existing AS (
    SELECT DISTINCT nocif
    FROM edl_sandbox.da_ad_tfd_trxnt_compre
    WHERE batch_date = (SELECT MAX(batch_date) FROM edl_sandbox.da_ad_tfd_trxnt_compre)
),

-- 10.2 Target customers: business entities (cust_type = 'C'), not Corporate/Commercial,
--      and not yet in the main TFD
tmp_base AS (
    SELECT
        a.nocif,
        cl.full_name AS nama,
        COUNT(DISTINCT segmenbsi) AS n_segmenbsi,
        COUNT(DISTINCT kodebu)    AS n_kodebu,
        GROUP_CONCAT(DISTINCT a.segmenbsi, ',') AS segmenbsi,
        GROUP_CONCAT(DISTINCT a.kodebu, ',')    AS kodebu
    FROM edl_datamart.master_dpk_bsi a
    LEFT JOIN edl_src.customer_latest cl ON cl.cif_no = a.nocif
    LEFT JOIN tmp_tfd_existing tfd       ON tfd.nocif = a.nocif
    WHERE a.batch_date = '${END_DATE}'
      -- AND a.segmenbsi IN ('ISLAMIC ECOSYSTEM', 'INSTITUTIONAL BANKING', 'SME')
      AND a.segmenbsi NOT IN ('CORPORATE', 'COMMERCIAL')
      AND cl.cust_type = 'C'
      AND tfd.nocif IS NULL
    GROUP BY a.nocif, cl.full_name
),

-- 10.3 Month-end deposit position, per product type
tmp_dpk AS (
    SELECT
        a.batch_date,
        bs.nocif, bs.nama, bs.segmenbsi, bs.kodebu,
        MIN(a.tanggalbukacif) AS tglbuka,
        COUNT(a.norekening)   AS dpk_noa,
        SUM(a.saldo)          AS dpk_bal,
        SUM(CASE WHEN a.jenisproduk IN ('Tabungan', 'Giro') THEN 1 ELSE 0 END)        AS casa_noa,
        SUM(CASE WHEN a.jenisproduk IN ('Tabungan', 'Giro') THEN a.saldo ELSE 0 END) AS casa_bal,
        SUM(CASE WHEN a.jenisproduk = 'Tabungan' THEN 1 ELSE 0 END)                  AS tab_noa,
        SUM(CASE WHEN a.jenisproduk = 'Tabungan' THEN a.saldo ELSE 0 END)            AS tab_bal,
        SUM(CASE WHEN a.jenisproduk = 'Giro' THEN 1 ELSE 0 END)                      AS giro_noa,
        SUM(CASE WHEN a.jenisproduk = 'Giro' THEN a.saldo ELSE 0 END)                AS giro_bal,
        SUM(CASE WHEN a.jenisproduk = 'Deposito' THEN 1 ELSE 0 END)                  AS depo_noa,
        SUM(CASE WHEN a.jenisproduk = 'Deposito' THEN a.saldo ELSE 0 END)            AS depo_bal
    FROM edl_datamart.master_dpk_bsi a
    INNER JOIN tmp_base bs ON bs.nocif = a.nocif
    WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
      AND a.batch_date = LAST_DAY(a.batch_date)
    GROUP BY a.batch_date, bs.nocif, bs.nama, bs.segmenbsi, bs.kodebu
),

-- 10.4 Month-end financing position (Hasanah card excluded)
tmp_pby AS (
    SELECT
        a.batch_date,
        a.nocif,
        COUNT(a.norekening)   AS pby_noa,
        MAX(a.kolektibilitas) AS pby_kol,
        SUM(a.sisapokokpsak)  AS pby_os_pokok,
        SUM(a.sisamargin)     AS pby_os_margin,
        SUM(a.ckpn)           AS pby_ckpn,
        SUM(a.pencairanpokok) AS pby_pokok_cair
    FROM edl_datamart.master_pembiayaan a
    WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
      AND a.batch_date = LAST_DAY(a.batch_date)
      AND subproduct2 <> 'HASANAH CARD'
    GROUP BY a.batch_date, a.nocif
),

-- 10.5 Customer's economic sector: taken from the financing with the largest disbursement
tmp_pby_sektor AS (
    SELECT nocif, sektor_eko1, sektor_eko2
    FROM (
        SELECT
            a.nocif,
            b.sandilsmkdesc     AS sektor_eko1,
            b.clustersekonlsmk  AS sektor_eko2,
            a.pencairanpokok,
            ROW_NUMBER() OVER (PARTITION BY a.nocif ORDER BY a.pencairanpokok DESC) AS rnk
        FROM edl_datamart.master_pembiayaan a
        LEFT JOIN edl_reference.ref_sektor_ekonomi b ON b.sandilsmk = a.sektorekonomi
        WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
          AND a.batch_date = LAST_DAY(a.batch_date)
          AND subproduct2 <> 'HASANAH CARD'
    ) a
    WHERE rnk = 1
),

-- 10.6 Combine deposits + financing + sector
tmp_corp_final AS (
    SELECT
        a.batch_date, a.nocif, a.nama, a.tglbuka, a.segmenbsi, a.kodebu,
        a.dpk_noa, a.dpk_bal,
        a.casa_noa, a.casa_bal,
        a.tab_noa, a.tab_bal,
        a.giro_noa, a.giro_bal,
        a.depo_noa, a.depo_bal,
        COALESCE(b.pby_noa, 0)        AS pby_noa,
        b.pby_kol,
        COALESCE(b.pby_os_pokok, 0)   AS pby_pokok_os,
        COALESCE(b.pby_os_margin, 0)  AS pby_margin_os,
        COALESCE(b.pby_ckpn, 0)       AS pby_ckpn,
        COALESCE(b.pby_pokok_cair, 0) AS pby_pokok_cair,
        c.sektor_eko1,
        c.sektor_eko2
    FROM tmp_dpk a
    LEFT JOIN tmp_pby b
        ON b.batch_date = a.batch_date
       AND b.nocif = a.nocif
    LEFT JOIN tmp_pby_sektor c
        ON c.nocif = a.nocif
)
-- INSERT OVERWRITE TABLE edl_sandbox.da_ad_tfdlite_corp_stg
SELECT * FROM tmp_corp_final
;


/* ---------------------------------------------------------------------
   STEP 11 : PULL DETAILED TRANSACTIONS
   Purpose : Pull all account transactions of other-segment customers and
             enrich them with bank names, BI-FAST, SKN, and RTGS information.
             Cancelled transactions (status REVE) are
             excluded.
   Source  : trx_account_detail, master_dpk_bsi, bifast_*, skn_*, rtgs_*
   Result  : edl_sandbox.da_ad_tfdlite_trx_kutu_augsep_only
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.da_ad_tfdlite_trx_kutu_augsep_only PURGE;
-- Check result: SELECT * FROM edl_sandbox.da_ad_tfdlite_trx_kutu_augsep_only LIMIT 100;

CREATE TABLE edl_sandbox.da_ad_tfdlite_trx_kutu_augsep_only
STORED AS PARQUET AS  

WITH
-- 11.1 Customers already in the main TFD (excluded)
tmp_tfd_existing AS (
    SELECT DISTINCT nocif
    FROM edl_sandbox.da_ad_tfd_trxnt_compre
    WHERE batch_date = (SELECT MAX(batch_date) FROM edl_sandbox.da_ad_tfd_trxnt_compre)
),

-- 11.2 Target customers (same as step 10.2)
tmp_base AS (
    SELECT
        a.nocif,
        cl.full_name AS nama,
        COUNT(DISTINCT segmenbsi) AS n_segmenbsi,
        COUNT(DISTINCT kodebu)    AS n_kodebu,
        GROUP_CONCAT(DISTINCT a.segmenbsi, ',') AS segmenbsi,
        GROUP_CONCAT(DISTINCT a.kodebu, ',')    AS kodebu
    FROM edl_datamart.master_dpk_bsi a
    LEFT JOIN edl_src.customer_latest cl ON cl.cif_no = a.nocif
    LEFT JOIN tmp_tfd_existing tfd       ON tfd.nocif = a.nocif
    WHERE a.batch_date = '${END_DATE}'
      -- AND a.segmenbsi IN ('ISLAMIC ECOSYSTEM', 'INSTITUTIONAL BANKING', 'SME')
      AND a.segmenbsi NOT IN ('CORPORATE', 'COMMERCIAL')
      AND cl.cust_type = 'C'
      AND tfd.nocif IS NULL
    GROUP BY a.nocif, cl.full_name
),

-- 11.3 Accounts owned by the target customers
tmp_base_rek AS (
    SELECT
        b.nocif, b.nama, b.segmenbsi, b.kodebu,
        a.ciflegacy, a.norekening
    FROM edl_datamart.master_dpk_bsi a
    INNER JOIN tmp_base b ON b.nocif = a.nocif
    WHERE a.batch_date = '${END_DATE}'
),

-- 11.4 Summarise per CIF
tmp_base_cif AS (
    SELECT
        nocif, nama, ciflegacy, segmenbsi, kodebu,
        COUNT(1) AS jml_rek
    FROM tmp_base_rek
    GROUP BY nocif, nama, ciflegacy, segmenbsi, kodebu
),

-- 11.5 All BSI accounts (to recognise whether the counterparty account is also at BSI)
tmp_all_rek AS (
    SELECT DISTINCT
        COALESCE(b.supercif_no, a.ciflegacy) AS nocif,
        a.norekening,
        cl.full_name AS nama,
        a.jenisproduk
    FROM edl_datamart.master_dpk_bsi a
    LEFT JOIN edl_src.ds_cif_dup_single b ON b.cif_no = a.ciflegacy
    LEFT JOIN edl_src.customer_latest cl  ON cl.cif_no = COALESCE(b.supercif_no, a.ciflegacy)
    WHERE a.batch_date = '${END_DATE}'
),

-- 11.6 Account transactions + transaction name, commission type, bank name, and indicators
--      for transfers between BSI accounts (flag_pb_bsi) / within the same customer (flag_pb_cif)
tmp_trx_base AS (
    SELECT DISTINCT
        b.nocif, b.nama, a.cif_no, a.account_number, jp.jenisproduk, a.batch_date, a.system_id,
        a.trans_reference, a.dk,
        ABS(a.amount_trx) AS amount_trx,
        a.amount_trx_fcy,
        a.debit_acct_no, a.debit_ccy, a.credit_acct_no, a.credit_ccy,
        a.transaction_cd, c.trx_nm, a.commission_type, ct.commission_nm,
        a.narrative, a.payment_details,
        a.ben_acct_no, a.ben_customer,
        COALESCE(bnk1.bankname, a.ben_bank) AS ben_bank,
        a.ben_name, a.ben_acc,
        a.in_ben_acct_no, a.in_ben_customer,
        COALESCE(bnk2.bankname, a.in_ben_bank) AS in_ben_bank,
        a.rtgs_code,
        COALESCE(bnk3.bankname, a.rtgs_code) AS rtgs_bank,
        a.record_status,
        COALESCE(bnk4.bankname, a.ati_recvr_bnk) AS ati_recvr_bnk,
        a.ati_recvr_no, a.ati_recvr_nm,
        a.ati_sen_rev_nm,
        COALESCE(bnk5.bankname, a.ati_sender_bnk) AS ati_sender_bnk,
        b1.nocif AS db_nocif,
        b1.nama  AS db_nm,
        b2.nocif AS cr_nocif,
        b2.nama  AS cr_nm,
        CASE WHEN (b1.nocif = b2.nocif) AND (b1.nocif = b.nocif) THEN 1 ELSE 0 END AS flag_pb_cif,
        CASE WHEN (b1.nocif IS NOT NULL) AND (b2.nocif IS NOT NULL) THEN 1 ELSE 0 END AS flag_pb_bsi
    FROM edl_datamart.trx_account_detail a
    INNER JOIN tmp_base_cif b ON b.ciflegacy = a.cif_no
    LEFT JOIN edl_reference.lookup_stmt_transaction c ON c.trx_cd = a.transaction_cd
    LEFT JOIN edl_reference.lookup_commission_type ct ON ct.commission_cd = a.commission_type
    LEFT JOIN tmp_all_rek jp ON jp.norekening = a.account_number
    -- check whether the debit/credit account belongs to the same CIF or another BSI account
    LEFT JOIN tmp_all_rek b1 ON b1.norekening = a.debit_acct_no
    LEFT JOIN tmp_all_rek b2 ON b2.norekening = a.credit_acct_no
    -- look up bank name from bank code
    LEFT JOIN edl_src.bifast_tbank bnk1 ON bnk1.bankcode  = a.ben_bank
    LEFT JOIN edl_src.bifast_tbank bnk2 ON bnk2.bankcode  = a.in_ben_bank
    LEFT JOIN edl_src.bifast_tbank bnk3 ON bnk3.swiftcode = a.rtgs_code
    LEFT JOIN edl_src.bifast_tbank bnk4 ON bnk4.bankcode  = a.ati_recvr_bnk
    LEFT JOIN edl_src.bifast_tbank bnk5 ON bnk5.bankcode  = a.ati_sender_bnk
    WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
),

-- 11.7 Cancelled transactions (status REVE)
tmp_reve AS (
    SELECT DISTINCT trans_reference
    FROM tmp_trx_base
    WHERE record_status = 'REVE'
),

-- 11.8 BI-FAST transaction details (sender/receiver name & bank)
tmp_bifast AS (
    SELECT
        a.batch_date,
        a.endtoendid AS bf_id,
        b.paymenttypedesc AS bf_payment_desc,
        COALESCE(bnk1.bankname, a.sourcebank) AS bf_source_bank,
        a.sourceaccid   AS bf_source_acc,
        COALESCE(bnk2.bankname, a.targetbank) AS bf_target_bank,
        a.targetaccid   AS bf_target_acc,
        a.sourceaccname AS bf_source_nm,
        a.targetaccname AS bf_target_nm
    FROM edl_src.bifast_tconnector a
    LEFT JOIN edl_src.bifast_tpaymenttype b ON b.paymenttypecode = a.paymenttype
    LEFT JOIN edl_src.bifast_tbank bnk1     ON bnk1.swiftcode = a.sourcebank
    LEFT JOIN edl_src.bifast_tbank bnk2     ON bnk2.swiftcode = a.targetbank
    WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
      AND a.paymenttype NOT IN ('510')
),

-- 11.9 SKN transaction details (BSMDIDJA = BSI bank code). D = debit/outgoing, K = credit/incoming
tmp_skn AS (
    SELECT
        CASE WHEN a.bic_pengirim_asal  = 'BSMDIDJA' THEN a.no_rek_nasabah_pengirim
             WHEN a.bic_penerima_akhir = 'BSMDIDJA' THEN a.no_rek_nasabah_penerima
        END AS account_number,
        CASE WHEN a.bic_pengirim_asal  = 'BSMDIDJA' THEN 'D'
             WHEN a.bic_penerima_akhir = 'BSMDIDJA' THEN 'K'
        END AS dk,
        CASE WHEN a.bic_pengirim_asal  = 'BSMDIDJA' THEN a.no_rek_nasabah_penerima
             WHEN a.bic_penerima_akhir = 'BSMDIDJA' THEN a.no_rek_nasabah_pengirim
        END AS account_opposition,
        COALESCE(bnk1.bankname, a.bic_pengirim_asal) AS skn_source_bank,
        a.nama_nasabah_pengirim    AS skn_source_nm,
        a.no_rek_nasabah_pengirim  AS skn_source_acc,
        COALESCE(bnk2.bankname, a.bic_penerima_akhir) AS skn_target_bank,
        a.nama_nasabah_penerima    AS skn_target_nm,
        a.no_rek_nasabah_penerima  AS skn_target_acc,
        a.nominal,
        a.batch_date
    FROM edl_src.skn_detail_dke_kr a
    LEFT JOIN edl_src.bifast_tbank bnk1 ON bnk1.swiftcode = a.bic_pengirim_asal
    LEFT JOIN edl_src.bifast_tbank bnk2 ON bnk2.swiftcode = a.bic_penerima_akhir
    WHERE a.batch_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
),

-- 11.10 RTGS incoming details
tmp_rtgs_in AS (
    SELECT
        a.process_date AS batch_date,
        a.reserver_2   AS rtgs_trans_ref,
        a.originating_name AS rtgs_source_nm,
        a.from_acc_no  AS rtgs_source_acc,
        COALESCE(bnk1.bankname, a.from_member) AS rtgs_source_bank,
        a.amount       AS rtgs_amount
    FROM edl_src.rtgs_in_trans a
    LEFT JOIN edl_src.bifast_tbank bnk1 ON bnk1.swiftcode = a.from_member
    WHERE a.process_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
),

-- 11.11 RTGS outgoing details
tmp_rtgs_out AS (
    SELECT
        a.process_date AS batch_date,
        a.ft_trans_ref AS rtgs_trans_ref,
        a.ben_name     AS rtgs_target_nm,
        a.ben_acc      AS rtgs_target_acc,
        COALESCE(bnk1.bankname, a.rec_bank) AS rtgs_target_bank,
        a.amount       AS rtgs_amount
    FROM edl_src.rtgs_out_trans a
    LEFT JOIN edl_src.bifast_tbank bnk1 ON bnk1.swiftcode = a.rec_bank
    WHERE a.process_date BETWEEN '${BEGIN_DATE}' AND '${END_DATE}'
)

-- 11.12 Combine all sources; remove cancelled transactions (REVE)
-- INSERT OVERWRITE TABLE edl_sandbox.da_ad_tfdlite_trx_stg
SELECT
    a.nocif, a.nama, a.cif_no, a.account_number, a.jenisproduk, a.batch_date, a.system_id,
    a.trans_reference, a.dk,
    a.amount_trx, a.amount_trx_fcy, a.debit_acct_no, a.debit_ccy, a.credit_acct_no, a.credit_ccy,
    a.transaction_cd, a.trx_nm, a.commission_type, a.commission_nm, a.narrative, a.payment_details,
    a.ben_acct_no, a.ben_customer, a.ben_bank, a.ben_name, a.ben_acc,
    a.in_ben_acct_no, a.in_ben_customer, a.in_ben_bank,
    a.rtgs_code, a.rtgs_bank, a.record_status,
    a.ati_recvr_bnk, a.ati_recvr_no, a.ati_recvr_nm, a.ati_sen_rev_nm, a.ati_sender_bnk,
    a.db_nocif, a.db_nm, a.cr_nocif, a.cr_nm, a.flag_pb_cif, a.flag_pb_bsi,
    b.bf_source_bank, b.bf_target_bank, b.bf_source_nm, b.bf_target_nm,
    c.skn_source_bank, c.skn_source_nm, c.skn_source_acc,
    c.skn_target_bank, c.skn_target_nm, c.skn_target_acc,
    rt_in.rtgs_source_nm, rt_in.rtgs_source_acc, rt_in.rtgs_source_bank,
    rt_out.rtgs_target_nm, rt_out.rtgs_target_acc, rt_out.rtgs_target_bank
FROM tmp_trx_base a
LEFT JOIN tmp_bifast b
    ON b.batch_date = a.batch_date
   AND b.bf_id = SPLIT_PART(a.payment_details, ' ', 1)
LEFT JOIN tmp_skn c
    ON c.batch_date = a.batch_date
   AND c.account_number = a.account_number
   AND c.dk = a.dk
   AND ABS(c.nominal - a.amount_trx) <= 1
   AND a.commission_nm LIKE '%SKN%'
   AND a.ben_acc = c.account_opposition
LEFT JOIN tmp_rtgs_in rt_in
    ON rt_in.rtgs_trans_ref = SUBSTR(a.trans_reference, 1, INSTR(a.trans_reference, '\\') - 1)
LEFT JOIN tmp_rtgs_out rt_out
    ON rt_out.rtgs_trans_ref = SUBSTR(a.trans_reference, 1, INSTR(a.trans_reference, '\\') - 1)
LEFT ANTI JOIN tmp_reve rv
    ON rv.trans_reference = a.trans_reference
;


/* -------------------------------------------------------------------------------
   STEP 12 : DETERMINE COUNTERPARTY NAME & BANK
   Purpose : Determine who the counterparty is (nama_rekanan) and its bank
             (bank_rekanan) by taking from several columns in order
             until a valid value is found (not empty / '-').
             Also flags which transactions are considered "reciprocal"
             (flag_trx_recipro = 1), i.e. transactions included in the analysis.
   Source  : da_ad_tfdlite_trx_kutu_augsep_only
   Result  : edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only
   -------------------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only;

CREATE TABLE edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only
STORED AS PARQUET AS 
-- INSERT OVERWRITE TABLE edl_sandbox.da_ad_tfdlite_trx1_stg
SELECT
    a.*,

    -- 12.1 Transactions included in the analysis (1 = yes).
    --      NOT included: multiposting, payroll, cash withdrawal, certain bill
    --      payments (MPS UBP, PLN Non Taglis, etc.), account closure, and transfer fees.
    CASE
        WHEN a.transaction_cd IN ('52','61','11','922','206','2','201','831','26','35','68','832','1','220','51','209','241') THEN 1
        WHEN (a.transaction_cd = '213' AND LOWER(a.commission_nm) NOT LIKE '%cash withdrawal%')
          OR (a.transaction_cd = '213' AND a.commission_nm IS NULL) THEN 1
        ELSE 0
    END AS flag_trx_recipro,

    -- 12.2 Counterparty name: outgoing (D) -> recipient name; incoming (K) -> sender name.
    --      Tried in order, taking the first source that has a value.
    CASE
        WHEN a.dk = 'D' THEN
            CASE
                WHEN a.cr_nm          IS NOT NULL AND TRIM(a.cr_nm)          NOT IN ('', '-') THEN a.cr_nm
                WHEN a.ben_name       IS NOT NULL AND TRIM(a.ben_name)       NOT IN ('', '-') THEN a.ben_name
                WHEN a.ati_recvr_nm   IS NOT NULL AND TRIM(a.ati_recvr_nm)   NOT IN ('', '-') THEN a.ati_recvr_nm
                WHEN a.bf_target_nm   IS NOT NULL AND TRIM(a.bf_target_nm)   NOT IN ('', '-') THEN a.bf_target_nm
                WHEN a.skn_target_nm  IS NOT NULL AND TRIM(a.skn_target_nm)  NOT IN ('', '-') THEN a.skn_target_nm
                WHEN a.rtgs_target_nm IS NOT NULL AND TRIM(a.rtgs_target_nm) NOT IN ('', '-') THEN a.rtgs_target_nm
                ELSE NULL
            END
        WHEN a.dk = 'K' THEN
            CASE
                -- [TECHNICAL NOTE] the first condition checks a.cr_nm while a.db_nm is the value taken;
                -- it probably should check a.db_nm. Left as in the original query - please verify.
                WHEN a.db_nm           IS NOT NULL AND TRIM(a.cr_nm)           NOT IN ('', '-') THEN a.db_nm
                WHEN a.ati_sen_rev_nm  IS NOT NULL AND TRIM(a.ati_sen_rev_nm)  NOT IN ('', '-') THEN a.ati_sen_rev_nm
                WHEN a.bf_source_nm    IS NOT NULL AND TRIM(a.bf_source_nm)    NOT IN ('', '-') THEN a.bf_source_nm
                WHEN a.skn_source_nm   IS NOT NULL AND TRIM(a.skn_source_nm)   NOT IN ('', '-') THEN a.skn_source_nm
                WHEN a.rtgs_source_nm  IS NOT NULL AND TRIM(a.rtgs_source_nm)  NOT IN ('', '-') THEN a.rtgs_source_nm
                ELSE NULL
            END
    END AS nama_rekanan,

    -- 12.3 Counterparty bank: if the transfer is between BSI accounts -> 'Bank BSI'; otherwise
    --      taken in order from the first source that has a value.
    CASE
        WHEN a.flag_pb_cif = 1 OR a.flag_pb_bsi = 1 THEN 'Bank BSI'
        WHEN a.dk = 'D' THEN
            CASE
                WHEN a.ben_bank         IS NOT NULL AND TRIM(a.ben_bank)         NOT IN ('', '-') THEN a.ben_bank
                WHEN a.ati_recvr_bnk    IS NOT NULL AND TRIM(a.ati_recvr_bnk)    NOT IN ('', '-') THEN a.ati_recvr_bnk
                WHEN a.bf_target_bank   IS NOT NULL AND TRIM(a.bf_target_bank)   NOT IN ('', '-') THEN a.bf_target_bank
                WHEN a.skn_target_bank  IS NOT NULL AND TRIM(a.skn_target_bank)  NOT IN ('', '-') THEN a.skn_target_bank
                WHEN a.rtgs_target_bank IS NOT NULL AND TRIM(a.rtgs_target_bank) NOT IN ('', '-') THEN a.rtgs_target_bank
                WHEN a.rtgs_bank        IS NOT NULL AND TRIM(a.rtgs_bank)        NOT IN ('', '-') THEN a.rtgs_bank
                ELSE NULL
            END
        WHEN a.dk = 'K' THEN
            CASE
                WHEN a.ati_sender_bnk   IS NOT NULL AND TRIM(a.ati_sender_bnk)   NOT IN ('', '-') THEN a.ati_sender_bnk
                WHEN a.bf_source_bank   IS NOT NULL AND TRIM(a.bf_source_bank)   NOT IN ('', '-') THEN a.bf_source_bank
                WHEN a.skn_source_bank  IS NOT NULL AND TRIM(a.skn_source_bank)  NOT IN ('', '-') THEN a.skn_source_bank
                WHEN a.rtgs_source_bank IS NOT NULL AND TRIM(a.rtgs_source_bank) NOT IN ('', '-') THEN a.rtgs_source_bank
                WHEN a.rtgs_bank        IS NOT NULL AND TRIM(a.rtgs_bank)        NOT IN ('', '-') THEN a.rtgs_bank
                ELSE NULL
            END
    END AS bank_rekanan
FROM edl_sandbox.da_ad_tfdlite_trx_kutu_augsep_only a
;


/* ---------------------------------------------------------------------
   STEP 13 : SUMMARY OF TRANSACTIONS PER COUNTERPARTY
   Purpose : Summarise transactions per customer - per counterparty - per month:
             count (frequency) and amount (volume) for the debit side
             (outgoing) and credit side (incoming), plus the own-account
             indicator and the BSI bank indicator.
   Source  : da_ad_tfdlite_trx1_kutu_augsep_only,
            da_ad_tfdlite_corp_kutu_augsep_only
   Result  : edl_sandbox.da_ad_tfdlite_compre_kutu_augsep_only
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.da_ad_tfdlite_compre_kutu_augsep_only;
-- Check result: SELECT * FROM edl_sandbox.da_ad_tfdlite_compre_kutu_augsep_only LIMIT 100;

CREATE TABLE edl_sandbox.da_ad_tfdlite_compre_kutu_augsep_only
STORED AS PARQUET AS 

WITH
-- 13.1 Unique list of customer - counterparty - product per date (reciprocal transactions only)
--      flag_own = 1 if the counterparty name equals the customer name (own account)
tmp_trx_base AS (  
    SELECT
        a.batch_date,
        a.nocif,
        a.nama AS whl_cust_name,
        a.jenisproduk,
        COALESCE(a.nama_rekanan, 'unknown') AS trxnt_nm,
        COALESCE(a.bank_rekanan, 'unknown') AS trxnt_bnk,
        CASE WHEN a.nama_rekanan = a.nama THEN 1 ELSE 0 END AS flag_own,
        MAX(CASE WHEN a.dk = 'D' THEN a.cr_nocif ELSE a.db_nocif END) AS trxnt_nocif
    FROM edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only a
    WHERE a.flag_trx_recipro = 1
    GROUP BY
        a.batch_date, a.nocif, a.nama, a.jenisproduk,
        COALESCE(a.nama_rekanan, 'unknown'),
        COALESCE(a.bank_rekanan, 'unknown'),
        CASE WHEN a.nama_rekanan = a.nama THEN 1 ELSE 0 END
),

-- 13.2 Indicator for counterparties that have ever transacted between BSI accounts
tmp_flag_bsi AS (
    SELECT
        a.nama_rekanan,
        MAX(a.flag_pb_bsi) AS flag_pb_bsi
    FROM edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only a
    GROUP BY a.nama_rekanan
),

-- 13.3 Customer segment & BU code per date
tmp_segmen AS (
    SELECT DISTINCT
        batch_date,
        nocif,
        segmenbsi AS segmen_principal,
        kodebu    AS kodebu_principal
    FROM edl_sandbox.da_ad_tfdlite_corp_kutu_augsep_only
),

-- 13.4 Transaction frequency & amount per direction (D = outgoing, K = incoming)
trx_stg AS (
    SELECT
        batch_date, nocif, nama, jenisproduk,
        COALESCE(nama_rekanan, 'unknown') AS nama_rekanan,
        COALESCE(bank_rekanan, 'unknown') AS bank_rekanan,
        dk,
        COUNT(1)         AS total_freq,
        SUM(amount_trx)  AS amount_trx
    FROM edl_sandbox.da_ad_tfdlite_trx1_kutu_augsep_only
    WHERE flag_trx_recipro = 1
    GROUP BY
        batch_date, nocif, nama, jenisproduk,
        COALESCE(nama_rekanan, 'unknown'),
        COALESCE(bank_rekanan, 'unknown'),
        dk
),

-- 13.5 Combine: total, debit, and credit per customer - counterparty
tmp_trx AS (
    SELECT
        a.batch_date, a.nocif, a.whl_cust_name, a.jenisproduk,
        a.trxnt_nm, a.trxnt_bnk, a.trxnt_nocif, a.flag_own,
        c.flag_pb_bsi AS flag_bsi,
        SUM(b.total_freq)  AS total_freq,
        SUM(b.amount_trx)  AS total_vol,
        SUM(CASE WHEN b.dk = 'D' THEN 1 ELSE 0 END)             AS debit_freq,
        SUM(CASE WHEN b.dk = 'D' THEN b.amount_trx ELSE 0 END)  AS debit_vol,
        SUM(CASE WHEN b.dk = 'K' THEN 1 ELSE 0 END)             AS credit_freq,
        SUM(CASE WHEN b.dk = 'K' THEN b.amount_trx ELSE 0 END)  AS credit_vol
    FROM tmp_trx_base a
    LEFT JOIN trx_stg b
        ON b.batch_date   = a.batch_date
       AND b.nocif        = a.nocif
       AND b.jenisproduk  = a.jenisproduk
       AND b.nama_rekanan = a.trxnt_nm
       AND b.bank_rekanan = a.trxnt_bnk
    LEFT JOIN tmp_flag_bsi c
        ON c.nama_rekanan = a.trxnt_nm
    GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9
),

-- 13.6 Attach customer segment & BU code (matched to month-end)
final AS (
    SELECT
        a.batch_date, a.nocif, a.whl_cust_name,
        b.segmen_principal, b.kodebu_principal,
        a.jenisproduk, a.trxnt_nm, a.trxnt_bnk, a.trxnt_nocif,
        a.flag_own, a.flag_bsi,
        a.total_freq, a.total_vol,
        a.debit_freq, a.debit_vol,
        a.credit_freq, a.credit_vol
    FROM tmp_trx a
    LEFT JOIN tmp_segmen b
        ON b.batch_date = LAST_DAY(a.batch_date)
       AND b.nocif = a.nocif
)
-- INSERT OVERWRITE TABLE edl_sandbox.da_ad_tfdlite_compre_stg
SELECT * FROM final
;


