/* ===========================================================================================
   TRANSACTION FLOW DIAGRAM (TFD) ANALYSIS & POTENTIAL "LEAKAGE" OF FUNDS TO OTHER BANKS
   Last Run : 2026-11-09
   ===========================================================================================

   PURPOSE:
   Collect all transactions of Corporate, Commercial, Islamic Ecosystem, Institutional Banking, and SME Customers
   via TFD, then measure how much money flows out to accounts at other banks (non-BSI) - called "leakage".

   KEY TERMS
   - Principal  : the customer being analysed
   - Rekanan    : counterparty (the other party in a transaction with the principal)
   - INCOMING   : money coming into the principal   (credit side)
   - OUTGOING   : money going out of the principal  (debit side)
   - BSI / NBSI : counterparty holds an account at BSI / at another bank (non-BSI)
   - OWN / 3RD  : transfer to the customer's own account / to a third party
   - Leakage    : OUTGOING funds to non-BSI accounts
   - Frek / Vol : number of transactions / transaction amount
   - CIF        : customer identification number at the bank

   INDONESIAN WORDS USED IN TABLE / COLUMN NAMES
   - nasabah = customer, rekanan = counterparty, pembiayaan = financing (loans)
   - simpanan / DPK = deposits, cabang = branch, kodebu = business unit (BU) code
   - perorangan / individu = individual, badan usaha = business entity
   - awal / akhir = start / end, bulan = month, tahun = year

   PARAMETERS TO FILL IN BEFORE RUNNING
   ${batch_date_awal}, ${batch_date_akhir}  -> data period start / end (steps 1-9)
   ${BEGIN_DATE}, ${END_DATE}               -> data period start / end (steps 10-13)

   LIST OF STEPS
   PART A - Corporate & Commercial customers (TFD Compre)
     1.  Pull base transactions (incoming & outgoing)
     2.  Monthly summary per customer (volume & frequency)
     3.  Yearly summary per customer + financing & deposit data
     4.  Flag counterparties that are also wholesale customers (by CIF / name)
     5.  Flag counterparties whose names are similar to the principal (similarity)
     6.  Prepare branch / area / region reference per customer
     7.  Finalise principal tag + principal's branch
     8.  Determine counterparty's branch & segment
     9.  Reconciliation & final leakage flag (exclude individuals / payroll)
   PART B - Islamic Ecosystem, Institutional Banking, and SME customers (TFD Lite)
     10. Profile of other-segment customers
     11. Pull detailed transactions
     12. Determine counterparty name & bank
     13. Summary of transactions per counterparty
   PART C - All segments combined
     14. Combine TFD Compre + TFD Lite
     15. All-segment report (summary, top banks, top counterparties)
   PART D - Reports by sector
     16. Hajj & Umrah
     17. Healthcare
     18. Gold
     19. Oil & Gas
   ===================================================================== */


/* =====================================================================
   PART A - CORPORATE & COMMERCIAL CUSTOMERS
   ===================================================================== */


/* ---------------------------------------------------------------------
   STEP 1 : PULL BASE TRANSACTIONS
   Purpose : Collect all incoming (INCOMING) and outgoing (OUTGOING)
             transactions of Corporate/Commercial customers, together with
             the customer's segment and name.
   Source  : da_ad_tfd_trxnt_compre, da_wholesale_cleansing_tfd_s3
   Result  : edl_sandbox.wholesale_leakage_s1_242526
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s1_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s1_242526
STORED AS PARQUET AS   

WITH
-- 1.1 Latest profile of each customer (segment derived from BU code: 'CB' = Corporate)
base AS (
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY nocif_principal ORDER BY batch_date DESC) AS rn
    FROM (
        SELECT
            batch_date,
            nocif AS nocif_principal,
            IF(kodebu LIKE '%CB%', 'CORPORATE', 'COMMERCIAL') AS segmen,
            kodebu,
            TRIM(UPPER(whl_cust_name)) AS nama_principal
        FROM edl_sandbox.da_ad_tfd_trxnt_compre
        WHERE batch_date BETWEEN '${batch_date_awal}' AND '${batch_date_akhir}'
        GROUP BY 1, 2, 3, 4, 5
    ) x
),

-- 1.2 Keep only 1 row per customer (the latest one)
base_unq AS (
    SELECT nocif_principal, segmen, kodebu, nama_principal
    FROM base
    WHERE rn = 1
    GROUP BY nocif_principal, segmen, kodebu, nama_principal
),

-- 1.3 OUTGOING transactions (debit side)
trx_out AS (
    SELECT
        nocif_principal, nocif_rekanan, nama_rekanan, segmen_rekanan, bank_rekanan,
        flag_own_final AS flag_own,
        flag_bsi_final AS flag_bsi,
        trx_channel, trx_type, trx_subtype, batch_date,
        SUM(frek_db) AS frek,
        SUM(vol_db)  AS vol
    FROM edl_sandbox.da_wholesale_cleansing_tfd_s3
    WHERE batch_date BETWEEN '${batch_date_awal}' AND '${batch_date_akhir}'
      AND frek_db > 0
      AND COALESCE(nocif_rekanan, nama_rekanan) <> ''
    GROUP BY
        nocif_principal, nocif_rekanan, nama_rekanan, segmen_rekanan, bank_rekanan,
        flag_own_final, flag_bsi_final, trx_channel, trx_type, trx_subtype, batch_date
),

-- 1.4 INCOMING transactions (credit side)
trx_in AS (
    SELECT
        nocif_principal, nocif_rekanan, nama_rekanan, segmen_rekanan, bank_rekanan,
        flag_own_final AS flag_own,
        flag_bsi_final AS flag_bsi,
        trx_channel, trx_type, trx_subtype, batch_date,
        SUM(frek_cr) AS frek,
        SUM(vol_cr)  AS vol
    FROM edl_sandbox.da_wholesale_cleansing_tfd_s3
    WHERE batch_date BETWEEN '${batch_date_awal}' AND '${batch_date_akhir}'
      AND frek_cr > 0
      AND COALESCE(nocif_rekanan, nama_rekanan) <> ''
    GROUP BY
        nocif_principal, nocif_rekanan, nama_rekanan, segmen_rekanan, bank_rekanan,
        flag_own_final, flag_bsi_final, trx_channel, trx_type, trx_subtype, batch_date
),

-- 1.5 Combine incoming & outgoing, label the direction of the transaction
gab AS (
    SELECT *, 'INCOMING' AS flag FROM trx_in
    UNION
    SELECT *, 'OUTGOING' AS flag FROM trx_out
),

-- 1.6 Attach the customer's segment & name
final AS (
    SELECT
        b.segmen,
        b.kodebu,
        b.nama_principal,
        a.*
    FROM gab a
    LEFT JOIN base_unq b
        ON a.nocif_principal = b.nocif_principal
)
SELECT * FROM final
;


/* ---------------------------------------------------------------------
   STEP 2 : MONTHLY SUMMARY PER CUSTOMER
   Purpose : Sum up transaction volume & frequency of each customer per
             month, split by direction (in/out), bank (BSI/non-BSI)
             and account type (own account / third party).
   Source  : wholesale_leakage_s1_242526
   Result  : edl_sandbox.wholesale_leakage_s2_242526
   Column codes : in = incoming, out = outgoing | bsi / nbsi = BSI bank / other bank
                  own = own account, 3rd = third party
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s2_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s2_242526
STORED AS PARQUET AS 

WITH
-- 2.1 Step 1 data + BSI bank indicator (1 = Bank BSI, 0 = other bank)
base AS (
    SELECT
        *,
        IF(bank_rekanan = 'Bank BSI', 1, 0) AS flag_bsi2
    FROM edl_sandbox.wholesale_leakage_s1_2425
    WHERE batch_date BETWEEN '${batch_date_awal}' AND '${batch_date_akhir}'
),

-- 2.2 Count counterparties, volume, and frequency per customer per month
s1 AS (
    SELECT
        nocif_principal, nama_principal, segmen, kodebu, batch_date,
        COUNT(DISTINCT COALESCE(nocif_rekanan, nama_rekanan)) AS jml_rekanan,

        -- INCOMING VOLUME
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 1 AND flag_own = 1, CAST(vol AS DOUBLE), 0)) AS vol_in_bsi_own,
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 1 AND flag_own = 0, CAST(vol AS DOUBLE), 0)) AS vol_in_bsi_3rd,
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 0 AND flag_own = 1, CAST(vol AS DOUBLE), 0)) AS vol_in_nbsi_own,
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 0 AND flag_own = 0, CAST(vol AS DOUBLE), 0)) AS vol_in_nbsi_3rd,
        SUM(IF(flag = 'INCOMING',                                    CAST(vol AS DOUBLE), 0)) AS vol_in_total,

        -- OUTGOING VOLUME
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 1 AND flag_own = 1, CAST(vol AS DOUBLE), 0)) AS vol_out_bsi_own,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 1 AND flag_own = 0, CAST(vol AS DOUBLE), 0)) AS vol_out_bsi_3rd,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0 AND flag_own = 1, CAST(vol AS DOUBLE), 0)) AS vol_out_nbsi_own,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0 AND flag_own = 0, CAST(vol AS DOUBLE), 0)) AS vol_out_nbsi_3rd,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0,                  CAST(vol AS DOUBLE), 0)) AS vol_out_nbsi,
        SUM(IF(flag = 'OUTGOING',                                    CAST(vol AS DOUBLE), 0)) AS vol_out_total,

        -- INCOMING FREQUENCY
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 1 AND flag_own = 1, CAST(frek AS DOUBLE), 0)) AS frek_in_bsi_own,
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 1 AND flag_own = 0, CAST(frek AS DOUBLE), 0)) AS frek_in_bsi_3rd,
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 0 AND flag_own = 1, CAST(frek AS DOUBLE), 0)) AS frek_in_nbsi_own,
        -- [TECHNICAL NOTE] the condition below uses flag_own = 1 (same as the line above);
        -- it probably should be flag_own = 0. Left as in the original query - please verify.
        SUM(IF(flag = 'INCOMING' AND flag_bsi2 = 0 AND flag_own = 1, CAST(frek AS DOUBLE), 0)) AS frek_in_nbsi_3rd,
        SUM(IF(flag = 'INCOMING',                                    CAST(frek AS DOUBLE), 0)) AS frek_in_total,

        -- OUTGOING FREQUENCY
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 1 AND flag_own = 1, CAST(frek AS DOUBLE), 0)) AS frek_out_bsi_own,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 1 AND flag_own = 0, CAST(frek AS DOUBLE), 0)) AS frek_out_bsi_3rd,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0 AND flag_own = 1, CAST(frek AS DOUBLE), 0)) AS frek_out_nbsi_own,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0 AND flag_own = 0, CAST(frek AS DOUBLE), 0)) AS frek_out_nbsi_3rd,
        SUM(IF(flag = 'OUTGOING' AND flag_bsi2 = 0,                  CAST(frek AS DOUBLE), 0)) AS frek_out_nbsi,
        SUM(IF(flag = 'OUTGOING',                                    CAST(frek AS DOUBLE), 0)) AS frek_out_total
    FROM base
    GROUP BY nocif_principal, nama_principal, segmen, kodebu, batch_date
)
SELECT * FROM s1
;


/* ---------------------------------------------------------------------
   STEP 3 : YEARLY SUMMARY PER CUSTOMER + FINANCING & DEPOSITS
   Purpose : Add up the monthly results into yearly totals, then add
             financing (loan) data, deposit (DPK) data, and the leakage
             flag (flag_leakage = 1 if funds went out to
             another bank).
   Source  : wholesale_leakage_s2_242526, master_pembiayaan, master_dpk_bsi
   Result  : edl_sandbox.wholesale_leakage_s3_242526
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s3_242526
STORED AS PARQUET AS 

WITH
-- 3.1 Total transactions per customer per year
--     (flag_periode is always 1 because all months 01-12 are included)
base AS (
    SELECT
        LEFT(batch_date, 4) AS tahun,
        IF(SUBSTRING(batch_date, 6, 2) IN ('01','02','03','04','05','06','07','08','09','10','11','12'), 1, 0) AS flag_periode,
        nocif_principal, nama_principal, segmen, kodebu,
        COUNT(DISTINCT batch_date) AS jml_bulan,
        SUM(jml_rekanan)       AS jml_rekanan,

        SUM(vol_in_bsi_own)    AS vol_in_bsi_own,
        SUM(vol_in_bsi_3rd)    AS vol_in_bsi_3rd,
        SUM(vol_in_nbsi_own)   AS vol_in_nbsi_own,
        SUM(vol_in_nbsi_3rd)   AS vol_in_nbsi_3rd,
        SUM(vol_in_total)      AS vol_in_total,

        SUM(vol_out_bsi_own)   AS vol_out_bsi_own,
        SUM(vol_out_bsi_3rd)   AS vol_out_bsi_3rd,
        SUM(vol_out_nbsi_own)  AS vol_out_nbsi_own,
        SUM(vol_out_nbsi_3rd)  AS vol_out_nbsi_3rd,
        SUM(vol_out_nbsi)      AS vol_out_nbsi,
        SUM(vol_out_total)     AS vol_out_total,

        SUM(frek_in_bsi_own)   AS frek_in_bsi_own,
        SUM(frek_in_bsi_3rd)   AS frek_in_bsi_3rd,
        SUM(frek_in_nbsi_own)  AS frek_in_nbsi_own,
        SUM(frek_in_nbsi_3rd)  AS frek_in_nbsi_3rd,
        SUM(frek_in_total)     AS frek_in_total,

        SUM(frek_out_bsi_own)  AS frek_out_bsi_own,
        SUM(frek_out_bsi_3rd)  AS frek_out_bsi_3rd,
        SUM(frek_out_nbsi_own) AS frek_out_nbsi_own,
        SUM(frek_out_nbsi_3rd) AS frek_out_nbsi_3rd,
        SUM(frek_out_nbsi)     AS frek_out_nbsi,
        SUM(frek_out_total)    AS frek_out_total
    FROM edl_sandbox.wholesale_leakage_s2_242526
    WHERE batch_date BETWEEN '2024-01-01' AND '2026-10-31'
    GROUP BY
        LEFT(batch_date, 4),
        IF(SUBSTRING(batch_date, 6, 2) IN ('01','02','03','04','05','06','07','08','09','10','11','12'), 1, 0),
        nocif_principal, nama_principal, segmen, kodebu
),

-- 3.2 Financing (loan) data per customer per year
loan AS (
    SELECT
        LEFT(batch_date, 4) AS tahun,
        nocif,
        SUM(CAST(pencairanpokok AS DOUBLE)) AS pencairan_loan,
        SUM(CAST(sisapokokpsak  AS DOUBLE)) AS outstanding
    FROM edl_datamart.master_pembiayaan
    WHERE batch_date IN ('2024-01-01', '2026-10-31')
      AND nocif IN (SELECT nocif_principal FROM base GROUP BY 1)
    GROUP BY LEFT(batch_date, 4), nocif
),

-- 3.3 Deposit (DPK) data per customer per year
dpk AS (
    SELECT
        LEFT(batch_date, 4) AS tahun,
        nocif,
        SUM(CAST(saldo AS DOUBLE))              AS saldo_dpk,
        SUM(CAST(saldoratarata_mtd AS DOUBLE))  AS avgbal_dpk
    FROM edl_datamart.master_dpk_bsi
    WHERE batch_date IN ('2024-01-01', '2026-10-31')
      AND nocif IN (SELECT nocif_principal FROM base GROUP BY 1)
    GROUP BY LEFT(batch_date, 4), nocif
),

-- 3.4 Attach loan data (matched by year); flag_debitur = 1 if the customer has financing
s1 AS (
    SELECT
        a.*,
        IF(b.nocif IS NOT NULL, 1, 0) AS flag_debitur,
        NVL(b.pencairan_loan, 0)      AS pencairan_loan,
        NVL(b.outstanding, 0)         AS sisa_pokok
    FROM base a
    LEFT JOIN loan b
        ON a.nocif_principal = b.nocif
       AND a.tahun = b.tahun
),

-- 3.5 Attach deposit data (matched by year)
s2 AS (
    SELECT
        a.*,
        NVL(b.saldo_dpk, 0)   AS saldo_dpk,
        NVL(b.avgbal_dpk, 0)  AS avgbal_dpk
    FROM s1 a
    LEFT JOIN dpk b
        ON a.nocif_principal = b.nocif
       AND a.tahun = b.tahun
),

-- 3.6 Flag customers with funds going out to other banks (leakage)
s3 AS (
    SELECT
        IF(vol_out_nbsi > 0, 1, 0) AS flag_leakage,
        *
    FROM s2
)
SELECT * FROM s3
;


/* ---------------------------------------------------------------------
   STEP 4 : FLAG COUNTERPARTIES THAT ARE ALSO WHOLESALE CUSTOMERS (ORIGINAL STEP 3a)
   Purpose : Determine whether the counterparty is also a BSI wholesale
             customer (matched by CIF or name), and count how many
             months transactions with that counterparty occurred.
   Source  : wholesale_leakage_s3_242526, wholesale_leakage_s1_242526,
            master_dpk_bsi, im_clary_averbal_cms_30_juni
   Result  : edl_sandbox.wholesale_leakage_s3a_242526
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3a_2425 PURGE;
-- Check batch_date: SELECT DISTINCT batch_date FROM edl_sandbox.wholesale_leakage_s3a_242526 ORDER BY batch_date;

CREATE TABLE edl_sandbox.wholesale_leakage_s3a_242526
STORED AS PARQUET AS

WITH
-- 4.1 List of customers from step 3
base AS (
    SELECT * FROM edl_sandbox.wholesale_leakage_s3_242526
),

-- 4.2 Detailed transactions from step 1 (only for the customers above)
tabel_s2 AS (
    SELECT
        *,
        IF(bank_rekanan = 'Bank BSI', 1, 0)        AS flag_bsi2,
        COALESCE(nocif_rekanan, nama_rekanan)      AS id_rekanan
    FROM edl_sandbox.wholesale_leakage_s1_242526
    WHERE batch_date BETWEEN '${batch_date_awal}' AND '${batch_date_akhir}'
      AND nocif_principal IN (SELECT nocif_principal FROM base GROUP BY 1)
),

-- 4.3 Number of months with transactions per customer-counterparty-direction
--     (calculated separately to avoid Impala errors)
bln_trx AS (
    SELECT
        LEFT(batch_date, 4) AS tahun,
        IF(SUBSTRING(batch_date, 6, 2) IN ('01','02','03','04','05','06','07','08','09','10','11','12'), 1, 0) AS flag_periode,
        nocif_principal,
        COALESCE(nocif_rekanan, nama_rekanan) AS id_rekanan,
        flag,
        COUNT(DISTINCT batch_date) AS jml_bln_trx
    FROM tabel_s2
    GROUP BY 1, 2, 3, 4, 5
),

-- 4.4 Transactions per month + number of transaction months
s1 AS (
    SELECT
        b.batch_date,
        a.tahun, a.flag_periode, a.flag_debitur, a.segmen, a.kodebu,
        a.nama_principal, a.nocif_principal,
        b.flag, b.nama_rekanan, b.nocif_rekanan, b.trx_channel,
        COALESCE(b.nocif_rekanan, b.nama_rekanan) AS id_rekanan,
        b.segmen_rekanan, b.bank_rekanan,
        b.flag_own AS flag_own,
        b.flag_bsi, b.flag_bsi2,
        b.flag AS flag_trx,
        c.jml_bln_trx,
        SUM(CAST(b.frek AS DOUBLE)) AS frek,
        SUM(CAST(b.vol  AS DOUBLE)) AS vol
    FROM base a
    INNER JOIN tabel_s2 b
        ON a.tahun = LEFT(b.batch_date, 4)
       AND a.flag_periode = IF(SUBSTRING(b.batch_date, 6, 2) IN ('01','02','03','04','05','06','07','08','09','10','11','12'), 1, 0)
       AND a.nocif_principal = b.nocif_principal
    LEFT JOIN bln_trx c
        ON a.tahun = c.tahun
       AND a.flag_periode = c.flag_periode
       AND b.nocif_principal = c.nocif_principal
       AND COALESCE(b.nocif_rekanan, b.nama_rekanan) = c.id_rekanan
       AND b.flag = c.flag
    GROUP BY
        b.batch_date,
        a.tahun, a.flag_periode, a.flag_debitur, a.segmen, a.kodebu,
        a.nama_principal, a.nocif_principal,
        b.flag, b.nama_rekanan, b.nocif_rekanan, b.trx_channel,
        COALESCE(b.nocif_rekanan, b.nama_rekanan),
        b.segmen_rekanan, b.bank_rekanan,
        b.flag_own, b.flag_bsi, b.flag_bsi2, b.flag,
        c.jml_bln_trx
),

-- 4.5 Customers with an active account (uREG data at the end date)
ureg AS (
    SELECT DISTINCT nocif_dpk_aktif AS cust_cif
    FROM edl_sandbox.im_clary_averbal_cms_30_juni
    WHERE batch_date = '${batch_date_akhir}'
),

-- 4.6 Flag principals registered in uREG
ureg1 AS (
    SELECT DISTINCT
        a.*,
        IF(b.cust_cif IS NOT NULL, 1, 0) AS flag_ureg_principal
    FROM s1 a
    LEFT JOIN ureg b
        ON a.nocif_principal = b.cust_cif
),

-- 4.7 Counterparties that have ever transacted with an own account (flag_own = 1)
flag_rekanan_principal AS (
    SELECT id_rekanan
    FROM tabel_s2
    WHERE flag_own = 1
    GROUP BY 1
),

-- 4.8 Wholesale customers in BSI deposits (Corporate/Commercial/Institutional)
dpk_wh AS (
    SELECT
        nocif,
        TRIM(UPPER(namacif)) AS namacif
    FROM edl_datamart.master_dpk_bsi
    WHERE batch_date = '${batch_date_akhir}'
      AND segmenbsi IN ('CORPORATE', 'COMMERCIAL', 'INSTITUTIONAL BANKING')
    GROUP BY 1, 2
),

-- 4.9 Check 1: counterparty = own account
final1 AS (
    SELECT
        a.*,
        IF(b.id_rekanan IS NOT NULL, 1, 0) AS flag_rekanan_principal1
    FROM ureg1 a
    LEFT JOIN flag_rekanan_principal b
        ON a.id_rekanan = b.id_rekanan
),

-- 4.10 Check 2: counterparty CIF is registered as a wholesale customer
final2 AS (
    SELECT
        a.*,
        IF(b.nocif IS NOT NULL, 1, 0) AS flag_rekanan_principal2
    FROM final1 a
    LEFT JOIN dpk_wh b
        ON a.nocif_rekanan = b.nocif
),

-- 4.11 Check 3: counterparty name equals a wholesale customer name
final3 AS (
    SELECT
        a.*,
        IF(b.namacif IS NOT NULL, 1, 0) AS flag_rekanan_principal3
    FROM final2 a
    LEFT JOIN (SELECT namacif FROM dpk_wh GROUP BY 1) b
        ON TRIM(UPPER(a.nama_rekanan)) = TRIM(UPPER(b.namacif))
),

-- 4.12 Conclusion: counterparty is treated as a principal if any of the 3 checks is met
final AS (
    SELECT
        a.*,
        CASE
            WHEN flag_rekanan_principal1 = 1 THEN 1
            WHEN flag_rekanan_principal2 = 1 THEN 1
            WHEN flag_rekanan_principal3 = 1 THEN 1
            ELSE 0
        END AS flag_principal
    FROM final3 a
)
SELECT * FROM final
;


/* ---------------------------------------------------------------------------------------
   STEP 5 : FLAG COUNTERPARTIES WITH NAMES SIMILAR TO THE PRINCIPAL (ORIGINAL STEP 3b)
   !!! DO NOT DROP THIS TABLE CASUALLY - THE CALCULATION IS HEAVY !!!
   Purpose : Detect counterparties whose names are very similar to the
             principal's name (possibly the same business group) using
             a text similarity score (Levenshtein). Treated as similar if
             the score is >= 85%.
   Source  : wholesale_leakage_s3a_2425, wholesale_cleansing_tfd_s2_similarity
   Result  : edl_sandbox.wholesale_leakage_s3b_2425
   --------------------------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3b_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s3b_242526
STORED AS PARQUET AS

WITH
base AS (
    SELECT * FROM edl_sandbox.wholesale_leakage_s3a_242526
),

-- 5.1 Unique principal names and their cleaned name version
principal AS (
    SELECT nama_principal FROM base GROUP BY 1
),
principal_clean AS (
    SELECT nama_principal, nama_principal_s5
    FROM edl_sandbox.wholesale_cleansing_tfd_s2_similarity
    GROUP BY 1, 2
),
principal_sim AS (   
    SELECT a.nama_principal, b.nama_principal_s5
    FROM principal a
    LEFT JOIN principal_clean b
        ON a.nama_principal = b.nama_principal
),

-- 5.2 Unique counterparty names and their cleaned name version
rekanan AS (
    SELECT nama_rekanan FROM base GROUP BY 1
),
rekanan_clean AS (   
    SELECT nama_rekanan, nama_rekanan_s6
    FROM edl_sandbox.wholesale_cleansing_tfd_s2_similarity
    WHERE TRIM(nama_rekanan) <> ''
    GROUP BY 1, 2
),
rekanan_sim AS (
    SELECT a.nama_rekanan, b.nama_rekanan_s6
    FROM rekanan a
    LEFT JOIN rekanan_clean b
        ON a.nama_rekanan = b.nama_rekanan
),

-- 5.3 Pair every counterparty with every principal (names tidied: upper case, trimmed)
pasangan AS (
    SELECT
        nama_principal, nama_rekanan,
        nama_principal_s5, nama_rekanan_s6,
        TRIM(UPPER(nama_principal_s5)) AS p,
        TRIM(UPPER(nama_rekanan_s6))   AS r
    FROM rekanan_sim
    CROSS JOIN principal_sim
),

-- 5.4 Compute character difference (Levenshtein) and the length of the longer of the two names
leven AS (
    SELECT
        nama_principal, nama_rekanan, nama_principal_s5, nama_rekanan_s6,
        LEVENSHTEIN(p, r) AS levenshtein_distance,
        LENGTH(CASE WHEN LENGTH(p) > LENGTH(r) THEN p ELSE r END) AS longer_length
    FROM pasangan
),

-- 5.5 Convert to a similarity percentage (1 = identical)
leven_pct AS (
    SELECT
        nama_principal, nama_rekanan, nama_principal_s5, nama_rekanan_s6,
        1 - (levenshtein_distance / CAST(longer_length AS DOUBLE)) AS levenshtein_percentage
    FROM leven
),

-- 5.6 Take the highest score per pair; keep only pairs with similarity >= 85%
leven_2 AS (
    SELECT
        nama_principal, nama_rekanan, nama_principal_s5, nama_rekanan_s6,
        MAX(levenshtein_percentage) AS sim_score,
        IF(MAX(levenshtein_percentage) >= 0.85, 1, 0) AS flag_similar
    FROM leven_pct
    GROUP BY nama_principal, nama_rekanan, nama_principal_s5, nama_rekanan_s6
    HAVING MAX(levenshtein_percentage) >= 0.85
)
SELECT * FROM leven_2
;


/* -----------------------------------------------------------------------------------
   STEP 6 : BRANCH / AREA / REGION REFERENCE PER CUSTOMER
   Purpose : Determine 1 "main" branch for each customer. If the
             customer has financing, the financing branch is used
             (priority 1); otherwise the deposit-account branch is used
             (priority 2). The account with the largest amount is chosen.
   Source  : master_pembiayaan, master_dpk_bsi, ref_cabang
   Result  : edl_sandbox.wholesale_temp_hirarki_region_242526
   Note    : this table is not used in steps 7-9 of this file
             (the branch in step 7 comes from dmx_whmart_hirarki_master_customer).
   ----------------------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_temp_hirarki_region_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_temp_hirarki_region_242526
STORED AS PARQUET AS

WITH
-- 6.1 Financing data (priority 1); JFAST product is excluded
pembiayaan AS (
    SELECT
        nocif, norekening,
        cabangbsi AS kode_cabang,
        segmenbsi, kodebu,
        SUM(NVL(pencairanpokok, 0)) AS amount,
        1 AS prio
    FROM edl_datamart.master_pembiayaan
    WHERE batch_date = '${batch_date_akhir}'
      AND subproduct2 <> 'JFAST'
    GROUP BY 1, 2, 3, 4, 5
),

-- 6.2 Deposit data (priority 2)
dpk AS (
    SELECT
        nocif, norekening,
        cabangrekeningbsi AS kode_cabang,
        segmenbsi, kodebu,
        SUM(NVL(saldo, 0)) AS amount,
        2 AS prio
    FROM edl_datamart.master_dpk_bsi
    WHERE batch_date = '${batch_date_akhir}'
    GROUP BY 1, 2, 3, 4, 5
),

-- 6.3 Branch -> area -> region reference table
cabang AS (
    SELECT
        cabangbsi, cabangbsi_desk,
        areabsi, areabsi_desk,
        regionbsi, regionbsi_desk
    FROM edl_reference.ref_cabang
    GROUP BY cabangbsi, cabangbsi_desk, areabsi, areabsi_desk, regionbsi, regionbsi_desk
),

-- 6.4 Combine financing & deposits
s1 AS (
    SELECT * FROM pembiayaan
    UNION ALL
    SELECT * FROM dpk
),

-- 6.5 Keep 1 row per customer: lowest priority number first, then largest amount
s2 AS (
    SELECT *
    FROM (
        SELECT
            *,
            ROW_NUMBER() OVER (PARTITION BY nocif ORDER BY prio ASC, amount DESC) AS rn1
        FROM s1
    ) x
    WHERE rn1 = 1
)

-- 6.6 Attach branch, area, and region names
SELECT DISTINCT
    a.*,
    b.cabangbsi_desk, b.areabsi, b.areabsi_desk, b.regionbsi, b.regionbsi_desk
FROM s2 a
LEFT JOIN cabang b
    ON a.kode_cabang = b.cabangbsi
;


/* --------------------------------------------------------------------------
   STEP 7 : FINALISE PRINCIPAL TAG + PRINCIPAL'S BRANCH (ORIGINAL STEP 3c)
   Purpose : Conclude whether the counterparty is a principal (combining
             results of steps 4 and 5), add the counterparty's deposit
             name, and the principal's branch/area/region.
   Source  : wholesale_leakage_s3a_242526, wholesale_leakage_s3b_242526,
            wholesale_cleansing_tfd_s2/s2a/s3_similarity,
            dmx_whmart_hirarki_master_customer
   Result  : edl_sandbox.wholesale_leakage_s3c_242526
   -------------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3c_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s3c_242526
STORED AS PARQUET AS  

WITH
base AS (
    SELECT * FROM edl_sandbox.wholesale_leakage_s3a_242526
),

-- 7.1 Counterparties with names similar to the principal (result of step 5)
sim AS (
    SELECT nama_rekanan
    FROM edl_sandbox.wholesale_leakage_s3b_242526
    WHERE flag_similar = 1
    GROUP BY 1
),

-- 7.2 Counterparties similar to the principal based on other cleansing tables
sim_from_own AS (
    SELECT DISTINCT TRIM(UPPER(nama_rekanan)) AS nama_rekanan
    FROM (
        SELECT
            CONCAT(nama_principal, nama_rekanan) AS penjoin2,
            nama_principal, nama_rekanan
        FROM edl_sandbox.wholesale_cleansing_tfd_s2a_similarity
        WHERE nama_rekanan IS NOT NULL
          AND nama_rekanan <> ''
          AND flag_sim_gab = 1
        GROUP BY 1, 2, 3

        UNION ALL

        SELECT
            CONCAT(nama_principal, nama_rekanan) AS penjoin2,
            nama_principal, nama_rekanan
        FROM edl_sandbox.wholesale_cleansing_tfd_s2_similarity
        WHERE flag_similar = 1
        GROUP BY 1, 2, 3
    ) x
),

-- 7.3 Counterparty name per deposit data
dpk_name AS (
    SELECT
        nama_rekanan,
        MAX(nama_dpk_rekanan) AS nama_dpk
    FROM edl_sandbox.wholesale_cleansing_tfd_s3_similarity
    WHERE TRIM(nama_rekanan) <> ''
    GROUP BY 1
),

-- 7.4 Final principal tag: any of (step 4 flag, similar in 7.1, similar in 7.2)
s1 AS (
    SELECT DISTINCT
        y.*,
        IF(flag_principal = 1 OR nama_rekanan_b IS NOT NULL OR nama_rekanan_c IS NOT NULL, 1, 0) AS flag_principal_final
    FROM (
        SELECT DISTINCT
            a.*,
            b.nama_rekanan AS nama_rekanan_b,
            c.nama_rekanan AS nama_rekanan_c
        FROM base a
        LEFT JOIN sim b
            ON TRIM(UPPER(a.nama_rekanan)) = TRIM(UPPER(b.nama_rekanan))
        LEFT JOIN sim_from_own c
            ON TRIM(UPPER(a.nama_rekanan)) = TRIM(UPPER(c.nama_rekanan))
    ) y
),

-- 7.5 Attach the counterparty's deposit name
s2 AS (
    SELECT DISTINCT
        a.*,
        b.nama_dpk
    FROM s1 a
    LEFT JOIN dpk_name b
        ON a.nama_rekanan = b.nama_rekanan
),

-- 7.6 Latest branch/area/region/segment data per customer
cabang AS (
    SELECT *
    FROM edl_datamart.dmx_whmart_hirarki_master_customer
    WHERE batch_date = '2026-10-31'
),

-- 7.7 Attach the principal's branch, area, region, segment & BU code
final AS (
    SELECT DISTINCT
        a.*,
        b.kode_cabang,
        b.nama_cabang  AS cabangbsi_desk,
        b.kode_area    AS areabsi,
        b.nama_area    AS areabsi_desk,
        b.kode_region  AS regionbsi,
        b.nama_region  AS regionbsi_desk,
        b.segmenbsi    AS segmen_new,
        b.kodebu       AS kodebu_new
    FROM s2 a
    LEFT JOIN cabang b
        ON a.nocif_principal = b.nocif
)
SELECT * FROM final
;


/* ---------------------------------------------------------------------
   STEP 8 : DETERMINE COUNTERPARTY'S BRANCH & SEGMENT (ORIGINAL STEP 3d)
   Purpose : Complete the counterparty CIF (if empty, look it up by name in
             deposit data), then find the counterparty's branch/area/region/
             segment and flag whether the counterparty is registered in uREG.
   Source  : wholesale_leakage_s3c_242526, master_dpk_bsi,
            dmx_whmart_hirarki_master_customer, im_clary_averbal_cms_30_juni
   Result  : edl_sandbox.wholesale_leakage_s3d_242526
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3d_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s3d_242526
STORED AS PARQUET AS

WITH
-- 8.1 Step 7 data + flags: counterparty CIF is valid (numeric) / deposit name available
base AS (
    SELECT DISTINCT
        *,
        IF(CAST(nocif_rekanan AS BIGINT) IS NOT NULL, 1, 0) AS flag_cif_rekanan,
        IF(nama_dpk IS NOT NULL, 1, 0)                      AS flag_nama_dpk
    FROM edl_sandbox.wholesale_leakage_s3c_242526
),

-- 8.2 Business-entity customers (individu = 'C') from deposit data; if 1 name has
--     several CIFs, take the one with the largest balance
dpk AS (
    SELECT *
    FROM (
        SELECT
            x.*,
            ROW_NUMBER() OVER (PARTITION BY nama_dpk ORDER BY saldo DESC) AS rn
        FROM (
            SELECT
                TRIM(UPPER(namacif)) AS nama_dpk,
                nocif,
                SUM(saldo) AS saldo
            FROM edl_datamart.master_dpk_bsi
            WHERE batch_date = '${batch_date_akhir}'
              AND TRIM(namacif) <> ''
              AND individu = 'C'
            GROUP BY 1, 2
        ) x
    ) y
    WHERE rn = 1
),

-- 8.3 Complete the counterparty CIF: use the original CIF; if empty, use the CIF found by name matching
s1 AS (
    SELECT
        a.*,
        b.nocif AS nocif_dpk,
        COALESCE(a.nocif_rekanan, b.nocif) AS nocif_rekanan_final
    FROM base a
    LEFT JOIN dpk b
        ON TRIM(UPPER(a.nama_dpk)) = TRIM(UPPER(b.nama_dpk))
),

-- 8.4 Latest branch/area/region/segment data per customer (date is hard-coded)
cabang AS (
    SELECT *
    FROM edl_datamart.dmx_whmart_hirarki_master_customer
    WHERE batch_date = '2026-10-31'
),

-- 8.5 Attach the counterparty's branch, area, region, segment & BU code (suffix _vc)
s2 AS (
    SELECT
        a.*,
        b.kode_cabang  AS kode_cabang_vc,
        b.nama_cabang  AS cabangbsi_desk_vc,
        b.kode_area    AS areabsi_vc,
        b.nama_area    AS areabsi_desk_vc,
        b.kode_region  AS regionbsi_vc,
        b.nama_region  AS regionbsi_desk_vc,
        b.segmenbsi    AS segmen_vc,
        b.kodebu       AS kodebu_vc
    FROM s1 a
    LEFT JOIN cabang b
        ON a.nocif_rekanan_final = b.nocif
),

-- 8.6 Customers registered in uREG
ureg AS (
    SELECT DISTINCT nocif_dpk_aktif AS cust_cif
    FROM edl_sandbox.im_clary_averbal_cms_30_juni
    WHERE batch_date = '${batch_date_akhir}'
),

-- 8.7 Flag counterparties registered in uREG
s3 AS (
    SELECT
        a.*,
        IF(b.cust_cif IS NOT NULL, 1, 0) AS flag_ureg_vc
    FROM s2 a
    LEFT JOIN ureg b
        ON a.nocif_rekanan_final = b.cust_cif
)

-- 8.8 Arrange final columns (flag_leakage = outgoing to another bank with amount > 0)
SELECT DISTINCT
    batch_date, tahun, flag_periode,
    IF(flag = 'OUTGOING' AND flag_bsi2 = 0 AND vol > 0, 1, 0) AS flag_leakage,
    flag_debitur, segmen, kodebu, nama_principal, nocif_principal, flag,
    TRIM(UPPER(nama_rekanan)) AS nama_rekanan,
    trx_channel,
    nocif_rekanan_final,
    COALESCE(nocif_rekanan_final, TRIM(UPPER(nama_rekanan))) AS id_rekanan,
    segmen_rekanan, bank_rekanan,
    flag_own, flag_bsi, flag_bsi2, flag_trx,
    jml_bln_trx, frek, vol,
    vol / jml_bln_trx AS vol_mly,                       -- average volume per month
    flag_ureg_principal,
    IF(flag_principal_final = 1 OR segmen_vc IN ('CORPORATE', 'COMMERCIAL', 'INSTITUTIONAL BANKING'), 1, 0) AS flag_principal_final,
    kode_cabang   AS kode_cabang_prin,
    cabangbsi_desk AS cabangbsi_desk_prin,
    areabsi       AS areabsi_prin,
    areabsi_desk  AS areabsi_desk_prin,
    regionbsi     AS regionbsi_prin,
    regionbsi_desk AS regionbsi_desk_prin,
    segmen_new    AS segmen_prin,
    kodebu_new    AS kodebu_prin,
    kode_cabang_vc, cabangbsi_desk_vc, areabsi_vc, areabsi_desk_vc,
    regionbsi_vc, regionbsi_desk_vc, segmen_vc, kodebu_vc,
    flag_ureg_vc
FROM s3
;


/* ---------------------------------------------------------------------
   STEP 9 : RECONCILIATION & FINAL LEAKAGE FLAG (ORIGINAL STEP 3e)
   Purpose : Decide which transactions are actually counted as
             leakage. Individual/payroll counterparties and certain
             principals are excluded; transactions to non-BSI are counted
             only if they occur in more than 1 month.
   Source  : wholesale_leakage_s3d_242526, master_dpk_bsi,
            master_payroll_phr_kolaborasi
   Result  : edl_sandbox.wholesale_leakage_s3e_242526
   Key result column : flag_outflow_nbsi_final (1 = counted)
   --------------------------------------------------------------------- */

-- DROP TABLE IF EXISTS edl_sandbox.wholesale_leakage_s3e_242526 PURGE;

CREATE TABLE edl_sandbox.wholesale_leakage_s3e_242526
STORED AS PARQUET AS

WITH
-- 9.1 Step 8 data for 2024-2026; certain principals are flagged for exclusion
--     (result of reconciliation with CFS)
base AS (  
    SELECT
        *,
        IF(nama_principal RLIKE 'TELEKOMUNIKASI SEL|JASA MARGA PER|SARANA MULTI IN|KALIMANTAN RIYA|ARCHIPELAGO TIMUR', 1, 0) AS flag_principal_exclude
    FROM edl_sandbox.wholesale_leakage_s3d_242526
    WHERE tahun RLIKE '2024|2025|2026'
),

-- 9.2 Individual customers (individu = 'R') - CIF and name
dpk AS (
    SELECT nocif
    FROM edl_datamart.master_dpk_bsi
    WHERE batch_date = '${batch_date_akhir}'
      AND individu = 'R'
    GROUP BY 1
),
dpknama AS (
    SELECT TRIM(UPPER(namacif)) AS namacif
    FROM edl_datamart.master_dpk_bsi
    WHERE batch_date = '${batch_date_akhir}'
      AND individu = 'R'
    GROUP BY 1
),

-- 9.3 Payroll customers (employees) - CIF and name 
payroll AS (
    SELECT DISTINCT nocif
    FROM edl_datamart.master_payroll_phr_kolaborasi
    WHERE batch_date = '${batch_date_akhir}'
),
payrollnama AS (
    SELECT DISTINCT namacif
    FROM edl_datamart.master_payroll_phr_kolaborasi
    WHERE batch_date = '${batch_date_akhir}'
),

-- 9.4 Flag individual counterparties by CIF
s1 AS (
    SELECT a.*, IF(b.nocif IS NOT NULL, 1, 0) AS flag_rekanan_individu_cif
    FROM base a
    LEFT JOIN dpk b
        ON a.nocif_rekanan_final = b.nocif
),

-- 9.5 Flag payroll counterparties by CIF
s2 AS (
    SELECT a.*, IF(b.nocif IS NOT NULL, 1, 0) AS flag_rekanan_payroll_cif
    FROM s1 a
    LEFT JOIN payroll b
        ON a.nocif_rekanan_final = b.nocif
),

-- 9.6 Flag individual counterparties by name
s3 AS (
    SELECT a.*, IF(b.namacif IS NOT NULL, 1, 0) AS flag_rekanan_individu_nama
    FROM s2 a
    LEFT JOIN dpknama b
        ON a.nama_rekanan = b.namacif
),

-- 9.7 Flag payroll counterparties by name
s4 AS (
    SELECT a.*, IF(b.namacif IS NOT NULL, 1, 0) AS flag_rekanan_payroll_nama
    FROM s3 a
    LEFT JOIN payrollnama b
        ON a.nama_rekanan = b.namacif
),

-- 9.8 Combine: treated as individual/payroll if matched by CIF OR by name
final AS (
    SELECT
        *,
        GREATEST(flag_rekanan_individu_cif, flag_rekanan_individu_nama) AS flag_rekanan_individu,
        GREATEST(flag_rekanan_payroll_cif,  flag_rekanan_payroll_nama)  AS flag_rekanan_payroll
    FROM s4
),

-- 9.9 Final flag: whether the transaction is counted (1 = yes)
--     - OUTGOING to non-BSI : counted if the principal is not excluded, the counterparty is not
--                             an individual/payroll, and transactions occur in > 1 month
--     - OUTGOING to BSI     : always counted
--     - INCOMING            : always counted
final1 AS (
    SELECT
        *,
        CASE
            WHEN flag_periode = 1 AND flag = 'OUTGOING' AND flag_bsi2 = 0
                 AND flag_principal_exclude = 0
                 AND flag_rekanan_individu = 0
                 AND jml_bln_trx > 1
                 AND flag_rekanan_payroll = 0 THEN 1
            WHEN flag_periode = 1 AND flag = 'OUTGOING' AND flag_bsi2 = 1 THEN 1
            WHEN flag_periode = 1 AND flag = 'INCOMING' THEN 1
            ELSE 0
        END AS flag_outflow_nbsi_final
    FROM final
)
SELECT * FROM final1
;


/* =====================================================================
   PART B - OTHER-SEGMENT CUSTOMERS (TFD LITE)
   Covers transactions of customers in segments other than Corporate/Commercial
   (e.g. Islamic Ecosystem, Institutional Banking, SME) that are not yet in
   the TFD Compre data.

   README - HOW TO RUN
   - Run steps 10-13 with the data period already parameterised.
   - Make sure the batch_date of staging and master data do NOT overlap.
   - To redo a batch_date, simply delete its partition in the master
     table (no need to drop and re-create the table).
   - The step that inserts into the master table (section "ORIGINAL STEP 4" below)
     does not need to be run; just use the table produced by step 13/14.
   ===================================================================== */

